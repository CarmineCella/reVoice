{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    { "name": "default", "displayName": "Release desktop build",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON" } },
    { "name": "debug", "inherits": "default", "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "sanitize", "inherits": "debug", "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": { "REVOICE_SANITIZERS": "ON", "REVOICE_BUILD_APP": "OFF" } },
    { "name": "plugins", "inherits": "default", "displayName": "VST3 and macOS AU plug-ins",
      "binaryDir": "${sourceDir}/build/plugins",
      "cacheVariables": { "REVOICE_BUILD_APP": "OFF", "REVOICE_BUILD_RENDERER": "OFF", "REVOICE_BUILD_PLUGINS": "ON" } },
    { "name": "macos-universal", "inherits": "default", "displayName": "Studio desktop for Apple Silicon and Intel",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "binaryDir": "${sourceDir}/build/universal",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" } },
    { "name": "macos-plugins-universal", "inherits": "plugins", "displayName": "Universal macOS VST3 and AU plug-ins",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "binaryDir": "${sourceDir}/build/plugins-universal",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" } }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Release" },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "sanitize", "configurePreset": "sanitize", "configuration": "Debug" },
    { "name": "plugins", "configurePreset": "plugins", "configuration": "Release" },
    { "name": "macos-universal", "configurePreset": "macos-universal", "configuration": "Release" },
    { "name": "macos-plugins-universal", "configurePreset": "macos-plugins-universal", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "sanitize", "configurePreset": "sanitize", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "plugins", "configurePreset": "plugins", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "macos-universal", "configurePreset": "macos-universal", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "macos-plugins-universal", "configurePreset": "macos-plugins-universal", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
