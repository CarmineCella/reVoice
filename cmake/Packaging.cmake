set(CPACK_PACKAGE_NAME reVoice)
set(CPACK_PACKAGE_VENDOR "Carmine Emanuele Cella")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Real-time vocal harmonizer")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_RESOURCE_FILE_LICENSE ${PROJECT_SOURCE_DIR}/LICENSE)
set(CPACK_COMPONENTS_ALL Runtime)
set(revoice_package_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
  set(revoice_package_archs "${CMAKE_OSX_ARCHITECTURES}")
  list(REMOVE_DUPLICATES revoice_package_archs)
  list(SORT revoice_package_archs)
  if(revoice_package_archs STREQUAL "arm64;x86_64")
    set(revoice_package_arch universal)
  else()
    string(REPLACE ";" "_" revoice_package_arch "${revoice_package_archs}")
  endif()
endif()
set(CPACK_PACKAGE_FILE_NAME "reVoice-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${revoice_package_arch}")
if(REVOICE_BUILD_PLUGINS AND NOT REVOICE_BUILD_APP)
  set(CPACK_COMPONENTS_ALL Runtime Plugins)
  set(CPACK_PACKAGE_FILE_NAME "reVoice-plugins-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${revoice_package_arch}")
  if(APPLE OR WIN32)
    set(CPACK_GENERATOR ZIP)
  else()
    set(CPACK_GENERATOR TGZ)
  endif()
elseif(APPLE AND REVOICE_BUILD_APP)
  set(CPACK_GENERATOR "DragNDrop")
  set(CPACK_DMG_VOLUME_NAME "reVoice ${PROJECT_VERSION}")
elseif(WIN32)
  set(CPACK_GENERATOR ZIP)
else()
  set(CPACK_GENERATOR TGZ)
endif()
include(CPack)
