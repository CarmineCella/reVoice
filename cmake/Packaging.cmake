set(CPACK_PACKAGE_NAME reVoice)
set(CPACK_PACKAGE_VENDOR "Carmine Emanuele Cella")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Real-time vocal harmonizer")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_RESOURCE_FILE_LICENSE ${PROJECT_SOURCE_DIR}/LICENSE)
set(CPACK_COMPONENTS_ALL Runtime)
set(CPACK_PACKAGE_FILE_NAME "reVoice-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND REVOICE_BUILD_APP)
  set(CPACK_GENERATOR "DragNDrop")
  set(CPACK_DMG_VOLUME_NAME "reVoice ${PROJECT_VERSION}")
elseif(WIN32)
  set(CPACK_GENERATOR ZIP)
else()
  set(CPACK_GENERATOR TGZ)
endif()
include(CPack)
